{
  "name": "@a-novel/platform-studio",
  "version": "0.1.0",
  "private": true,
  "description": "The creative workspace for the Agora Storyverse platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel/platform-studio.git"
  },
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "build": "vite build",
    "build:ci": "pnpm i18n:check && pnpm build && pnpm build:storybook",
    "build:storybook": "storybook build --output-dir storybook-static",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev",
    "format": "prettier --write . --config prettier.config.ts",
    "i18n:check": "pnpm i18n:extract:check && pnpm i18n:types:check && pnpm i18n:status && pnpm i18n:unused",
    "i18n:extract": "i18next-cli extract --with-types",
    "i18n:extract:check": "i18next-cli extract --ci --quiet",
    "i18n:status": "i18next-cli status",
    "i18n:types": "i18next-cli types",
    "i18n:types:check": "i18next-cli types --ci --quiet",
    "i18n:unused": "i18next-cli status --unused",
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm lint:stylecheck && pnpm lint:typecheck && pnpm lint:eslint && pnpm i18n:check",
    "lint:ci": "pnpm lint",
    "lint:eslint": "eslint .",
    "lint:stylecheck": "prettier --check . --config prettier.config.ts",
    "lint:typecheck": "pnpm check",
    "preview": "vite preview",
    "storybook": "BROWSER=none storybook dev --port 6006 --no-open",
    "test": "pnpm test:ci",
    "test:browser": "vitest run --project=browser --coverage.enabled=false",
    "test:ci": "pnpm test:unit && pnpm test:browser && pnpm test:storybook",
    "test:storybook": "vitest run --project=storybook --coverage.enabled=false",
    "test:unit": "vitest run --project=unit"
  },
  "dependencies": {
    "@a-novel-kit/nodelib-browser": "1.6.3",
    "@a-novel-kit/nodelib-i18n": "1.6.3",
    "@a-novel-kit/nodelib-server": "1.6.3",
    "@a-novel-kit/uikit": "0.2.1",
    "@a-novel-kit/uikit-fonts": "0.2.1",
    "@a-novel-kit/uikit-tokens": "0.2.1",
    "@a-novel/service-authentication-rest": "2.8.1",
    "@lucide/svelte": "1.41.0",
    "i18next": "26.4.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-config": "1.6.3",
    "@a-novel-kit/uikit-storybook": "0.2.1",
    "@eslint/compat": "2.1.1",
    "@eslint/config-helpers": "0.7.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-svelte-csf": "5.1.3",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/svelte": "10.6.0",
    "@storybook/sveltekit": "10.6.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-svelte": "3.23.0",
    "estree-walker": "3.0.3",
    "globals": "17.12.0",
    "i18next-cli": "1.73.1",
    "i18next-cli-plugin-svelte": "2.4.1",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-css-order": "2.2.0",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-svelte": "4.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-browser-svelte": "3.1.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.2"
  }
}
