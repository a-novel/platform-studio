{
  "name": "@a-novel/platform-studio",
  "version": "0.1.0",
  "private": true,
  "description": "The creative workspace for the Agora Storyverse platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel/platform-studio.git"
  },
  "license": "AGPL-3.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "build": "vite build",
    "build:ci": "pnpm build && pnpm build:storybook",
    "build:storybook": "storybook build --output-dir storybook-static",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev",
    "format": "prettier --write . --config prettier.config.ts",
    "i18n:check": "pnpm i18n:structure && pnpm i18n:gaps && pnpm i18n:drift",
    "i18n:drift": "nodelib-i18n-changes drift --source en",
    "i18n:extract": "i18next-cli extract && i18next-cli types",
    "i18n:extract:check": "i18next-cli extract --ci --quiet",
    "i18n:gaps": "nodelib-i18n-changes gaps --source en",
    "i18n:structure": "pnpm i18n:extract:check && pnpm i18n:types:check && pnpm i18n:unused",
    "i18n:types": "i18next-cli types",
    "i18n:types:check": "i18next-cli types --ci --quiet",
    "i18n:unused": "i18next-cli status --unused",
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm lint:stylecheck && pnpm lint:typecheck && pnpm lint:eslint && pnpm i18n:check",
    "lint:eslint": "eslint .",
    "lint:stylecheck": "prettier --check . --config prettier.config.ts",
    "lint:typecheck": "pnpm check",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "storybook": "BROWSER=none storybook dev --port 6006 --no-open",
    "test": "pnpm test:ci",
    "test:browser": "vitest run --project=browser --coverage.reportsDirectory=coverage/browser",
    "test:ci": "pnpm test:unit && pnpm test:browser && pnpm test:storybook && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:storybook": "vitest run --project=storybook --coverage.enabled=false",
    "test:unit": "vitest run --project=unit --coverage.reportsDirectory=coverage/unit"
  },
  "dependencies": {
    "@a-novel-kit/nodelib-browser": "1.10.0",
    "@a-novel-kit/nodelib-i18n": "1.10.0",
    "@a-novel-kit/nodelib-server": "1.10.0",
    "@a-novel-kit/uikit": "0.6.7",
    "@a-novel-kit/uikit-fonts": "0.6.7",
    "@a-novel-kit/uikit-images": "0.6.7",
    "@a-novel-kit/uikit-tokens": "0.6.7",
    "@a-novel/service-authentication-rest": "2.11.0",
    "@lucide/svelte": "1.52.0",
    "i18next": "26.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-config": "1.10.0",
    "@a-novel-kit/nodelib-test": "1.10.0",
    "@a-novel-kit/uikit-storybook": "0.6.7",
    "@eslint/compat": "2.1.1",
    "@eslint/config-helpers": "0.7.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-svelte-csf": "5.1.5",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/svelte": "10.6.1",
    "@storybook/sveltekit": "10.6.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-svelte": "3.23.0",
    "estree-walker": "3.0.3",
    "globals": "17.13.0",
    "i18next-cli": "1.75.0",
    "i18next-cli-plugin-svelte": "2.4.1",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "prettier": "3.9.9",
    "prettier-plugin-css-order": "2.2.0",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-svelte": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vitest-browser-svelte": "3.1.0"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.2"
  }
}
