{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "description": [
        "Stay on Vitest 4 while @storybook/addon-vitest 10.6 supports only Vitest 3 and 4."
      ],
      "matchPackageNames": ["vitest", "/^@vitest\\//"],
      "allowedVersions": "<5"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "bump",
      "enabled": true
    }
  ]
}
